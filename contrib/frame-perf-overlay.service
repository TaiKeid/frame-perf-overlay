[Unit]
Description=Frame Perf Overlay (performance panel for Steam Frame)
# OpenVR のオーバーレイなので SteamVR が動いている間だけ動かす
After=steamvr.service
PartOf=steamvr.service

[Service]
# 設定は ~/.config/frame-perf-overlay/config.json（無ければ既定値）
ExecStart=%h/.local/bin/frame-perf-overlay
# SteamVR だけ再起動したとき（steamvr.service は動いたまま）も戻ってくるよう、正常終了でも再起動する。
# steamvr.service が止まるときは PartOf で一緒に止まるので再起動はされない
Restart=always
RestartSec=5
# 設定パネルの「アプリを終了」で終わったときは終了コード 3 になる。ユーザーが自分で止めたので起動し直さない
RestartPreventExitStatus=3

[Install]
WantedBy=steamvr.service
